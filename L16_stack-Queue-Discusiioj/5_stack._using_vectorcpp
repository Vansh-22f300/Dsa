#include<bits/stdc++.h>
using namespace std;

class Stack{
public:
    vector<int> v;

    void push(int data){
        v.push_back(data);
    }
    void pop(){
        if(v.size() == 0){
            cout << "Stack underflow" << endl;
            return;
        }
        v.pop_back();
    }
    int top(){
        if(v.size() == 0){
            cout << "Stack is empty" << endl;
            return -1;
        }
        return v[v.size()-1];
    }
    int size(){
        return v.size();
    }
    bool isEmpty(){
        return v.size() == 0;
    }
};

int main(){
    Stack s;
    for(int i=1; i<5; i++){
        s.push(i);
    }
    while(!s.isEmpty()){
        cout << s.top() << " ";
        s.pop();
    }
    s.pop(); // Stack underflow
    s.pop();
    s.pop();
    s.pop();
    s.pop();
    s.pop();
    cout << endl;
}